# LSF Track configuration
#
# Copy to `.env`. In the Docker stack this file sits next to docker-compose.yml
# and compose interpolates it; running bare, export the LSF_* variables into the
# server's environment yourself.
#
# Every variable has a working default — a bare `docker compose up` boots with
# no .env at all. The four marked (!) are the ones a real deployment must set.

# ============================================================ Core

# (!) Session cookie signing key. Anyone holding this can forge any user's
# session, admin included. Placeholder values are refused at startup; leaving it
# empty generates a random ephemeral key (secure, but sessions reset on every
# restart). Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
LSF_SECRET_KEY=

# (!) Must be true in production. Only false while serving plain HTTP (local
# dev, or before DNS/TLS is set up) — a Secure cookie is never stored over
# plain HTTP, so login silently fails with true+HTTP.
LSF_SECURE_COOKIES=false

# Database. The compose stack builds this itself from POSTGRES_PASSWORD, so
# only set it when running bare. SQLite works for tests and demos; do not run
# production on it.
#LSF_DATABASE_URL=postgresql+psycopg://lsf:lsf@localhost:5432/lsf_track

# (!) Password for the `db` service (compose only; also baked into the app's
# connection URL). The default is `lsf`.
POSTGRES_PASSWORD=

# ============================================================ First boot

# The admin account created on first boot (never updated afterwards — rotate
# with `manage.py set-password`).
LSF_ADMIN_USERNAME=admin
# (!) Leave empty and a random password is generated and printed ONCE in the
# app container logs.
LSF_ADMIN_PASSWORD=

# Load sample factory data (projects, items, a week of events). Throwaway
# instances only.
LSF_DEMO=false

# ============================================================ Web / TLS

# Public hostname. When set, the Caddy proxy obtains Let's Encrypt certificates
# automatically and redirects HTTP to HTTPS (ports 80 and 443 must be open).
# When unset, the proxy serves plain HTTP on LSF_HTTP_PORT.
#LSF_DOMAIN=track.example.com

# Host port for plain-HTTP mode (ignored once LSF_DOMAIN is set).
LSF_HTTP_PORT=80

# ============================================================ Sessions

# Sliding session lifetime in days. Deliberately long: an engineer must never
# be logged out mid-shift while offline, or the sync queue can't drain.
LSF_SESSION_MAX_AGE_DAYS=30

# ============================================================ Photos & backups

# One private S3 bucket for item photos (images/) and nightly pg_dump archives
# (backups/). Unset = both stay on the local `uploads` volume: fine on a
# laptop, not durable in production. On EC2 use an instance role instead of
# keys, and raise the IMDS hop limit to 2 (see README) or containers can't
# reach role credentials.
#LSF_S3_BUCKET=
# Optional key prefix inside the bucket, e.g. "lsf/" to share a bucket.
#LSF_S3_PREFIX=
#AWS_DEFAULT_REGION=eu-west-1
# Only for non-EC2 hosts where an instance role isn't available:
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=

# How many nightly dumps to keep before pruning the oldest.
LSF_BACKUP_KEEP=30

# Local storage root when no bucket is set (a named volume in the stack).
#LSF_UPLOAD_DIR=data/uploads

# Per-photo upload cap in bytes (default 10MB).
#LSF_MAX_UPLOAD_BYTES=10485760

# ============================================================ Clock anomalies

# Events whose device time is more than this ahead of server receipt are
# flagged as a wrong device clock.
LSF_MAX_DEVICE_AHEAD_SECONDS=3600

# Events reaching the server more than this many days after they were logged
# are flagged as a late sync.
LSF_MAX_SYNC_LAG_DAYS=14
