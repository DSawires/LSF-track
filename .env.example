# Production target is PostgreSQL. SQLite is supported so the test suite and a
# local demo can run without a server; do not run production on it.
LSF_DATABASE_URL=postgresql+psycopg://lsf:lsf@localhost:5432/lsf_track

# Sign key for the session cookie. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
LSF_SECRET_KEY=change-me

# Sessions are long-lived and sliding: an engineer must not be logged out mid-shift
# while offline, or the sync queue can never drain.
LSF_SESSION_MAX_AGE_DAYS=30

# Cookie is sent over plain HTTP only when this is false (local dev).
LSF_SECURE_COOKIES=true

# Clock-skew anomaly thresholds (see docs in README).
LSF_MAX_DEVICE_AHEAD_SECONDS=3600
LSF_MAX_SYNC_LAG_DAYS=14
