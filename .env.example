# Production target is PostgreSQL. SQLite is supported so the test suite and a
# local demo can run without a server; do not run production on it.
LSF_DATABASE_URL=postgresql+psycopg://lsf:lsf@localhost:5432/lsf_track

# Sign key for the session cookie. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
# Placeholder values are refused at startup; empty means a random ephemeral key
# (sessions reset on every restart).
LSF_SECRET_KEY=

# --- Docker compose stack only ---
# Public hostname; when set, Caddy obtains TLS certificates automatically.
#LSF_DOMAIN=track.example.com
# First-boot admin account. If the password is unset, one is generated and
# printed once in the app container's logs.
#LSF_ADMIN_USERNAME=admin
#LSF_ADMIN_PASSWORD=
#POSTGRES_PASSWORD=

# One private S3 bucket for item photos (images/) and nightly database dumps
# (backups/). Unset = local disk on the uploads volume. On EC2 use an instance
# role instead of keys, and raise the IMDS hop limit to 2 so containers can
# reach instance credentials.
#LSF_S3_BUCKET=
#LSF_S3_PREFIX=
#LSF_BACKUP_KEEP=30
#AWS_DEFAULT_REGION=eu-west-1
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=

# Sessions are long-lived and sliding: an engineer must not be logged out mid-shift
# while offline, or the sync queue can never drain.
LSF_SESSION_MAX_AGE_DAYS=30

# Cookie is sent over plain HTTP only when this is false (local dev).
LSF_SECURE_COOKIES=true

# Clock-skew anomaly thresholds (see docs in README).
LSF_MAX_DEVICE_AHEAD_SECONDS=3600
LSF_MAX_SYNC_LAG_DAYS=14
